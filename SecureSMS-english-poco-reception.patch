index 0000000..b3b7f09
--- /dev/null
+++ b/app/src/main/java/com/securesms/app/messaging/PartesSmsEntrantes.kt
@@ -0,0 +1,20 @@
+// Distingue los segmentos físicos de Android de los fragmentos lógicos SS1.
+package com.securesms.app.messaging
+
+/** Reconstruye los segmentos de un mismo SMS antes de pasar su SS1 al ensamblador. */
+internal fun fragmentosSmsEntrantes(partes: List<String>): List<String> {
+    if (partes.size > 1 && partes.first().startsWith("SS1:") &&
+        partes.drop(1).none { it.startsWith("SS1:") }
+    ) {
+        return listOf(partes.joinToString("")).filter(::esFragmentoSms)
+    }
+    return partes.filter(::esFragmentoSms)
+}
+
+private fun esFragmentoSms(cuerpo: String): Boolean {
+    // Longitud máxima de SS1 con sus separadores y 130 caracteres de payload.
+    if (cuerpo.length > 153 || !cuerpo.startsWith("SS1:")) return false
+    val parte = parsear(cuerpo) ?: return false
+    return parte.index <= parte.count && parte.payload.isNotEmpty() &&
+        parte.payload.all { it in 'A'..'Z' || it in 'a'..'z' || it in '0'..'9' || it in "+/=" }
+}
diff --git a/app/src/main/java/com/securesms/app/messaging/ReceptorSmsAndroid.kt b/app/src/main/java/com/securesms/app/messaging/ReceptorSmsAndroid.kt
new file mode 100644
index 0000000..45730bc
--- /dev/null
+++ b/app/src/main/java/com/securesms/app/messaging/ReceptorSmsAndroid.kt
@@ -0,0 +1,30 @@
+// Recibe la notificación protegida de telefonía y extrae los fragmentos cifrados.
+package com.securesms.app.messaging
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.provider.Telephony
+import android.util.Log
+
+/** Android puede crear este receptor aunque aún no exista MainActivity. */
+class ReceptorSmsAndroid : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != Telephony.Sms.Intents.SMS_RECEIVED_ACTION) return
+        val mensajes = Telephony.Sms.Intents.getMessagesFromIntent(intent)
+        val porRemitente = mensajes.mapNotNull { mensaje ->
+            val remitente = mensaje?.originatingAddress ?: return@mapNotNull null
+            val cuerpo = mensaje.messageBody ?: return@mapNotNull null
+            remitente to cuerpo
+        }.groupBy({ it.first }, { it.second })
+
+        var fragmentos = 0
+        porRemitente.forEach { (remitente, partes) ->
+            fragmentosSmsEntrantes(partes).forEach { cuerpo ->
+                RegistroSmsEntrantes.entregar(remitente, cuerpo)
+                fragmentos++
+            }
+        }
+        Log.d("SecureSmsRx", "SMS broadcast: ${mensajes.size} PDU(s), $fragmentos SS1 fragment(s)")
+    }
+}
